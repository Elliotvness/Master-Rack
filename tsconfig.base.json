{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noPropertyAccessFromIndexSignature": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "useUnknownInCatchVariables": true,
    "forceConsistentCasingInFileNames": true,

    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true,
    "skipLibCheck": true,

    "baseUrl": ".",
    "paths": {
      "@rms/kernel-units": ["packages/kernel-units/src/index.ts"],
      "@rms/kernel-model": ["packages/kernel-model/src/index.ts"],
      "@rms/kernel-catalog": ["packages/kernel-catalog/src/index.ts"],
      "@rms/kernel-derive": ["packages/kernel-derive/src/index.ts"],
      "@rms/kernel-geom": ["packages/kernel-geom/src/index.ts"],
      "@rms/kernel-rules": ["packages/kernel-rules/src/index.ts"],
      "@rms/kernel-checks": ["packages/kernel-checks/src/index.ts"],
      "@rms/kernel-bom": ["packages/kernel-bom/src/index.ts"],
      "@rms/display-list": ["packages/display-list/src/index.ts"],
      "@rms/db": ["packages/db/src/index.ts"],
      "@rms/api": ["apps/api/src/index.ts"],
      "@rms/client-web": ["apps/client-web/src/index.ts"]
    }
  }
}
