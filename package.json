{
  "name": "rack-master-studio",
  "version": "0.0.0",
  "private": true,
  "description": "Client self-service pallet-rack configuration and quote-intake platform.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "typecheck": "tsc --build",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "eslint .",
    "check:boundaries": "node tools/check-boundaries.mjs",
    "check:boundaries:selftest": "node tools/selftest-boundaries.mjs",
    "check:docs": "python src/build.py",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm check:boundaries:selftest && pnpm check:boundaries",
    "clean": "tsc --build --clean"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@vitest/coverage-v8": "^2.1.0",
    "eslint": "^9.15.0",
    "globals": "^17.11.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.15.0",
    "vitest": "^2.1.0"
  }
}
