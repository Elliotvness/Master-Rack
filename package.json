{
  "name": "rack-master-studio",
  "version": "0.0.0",
  "private": true,
  "description": "Client self-service pallet-rack configuration and quote-intake platform.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "typecheck": "tsc --build && tsc -p tsconfig.tests.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "eslint .",
    "check:boundaries": "node tools/check-boundaries.mjs",
    "check:boundaries:selftest": "node tools/selftest-boundaries.mjs",
    "check:apps": "node tools/check-app-boundaries.mjs",
    "check:apps:selftest": "node tools/selftest-app-boundaries.mjs",
    "lint:provenance": "node tools/lint-provenance.mjs",
    "lint:provenance:selftest": "node tools/selftest-provenance.mjs",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "migrate": "node tools/migrate.mjs",
    "check:rls": "node tools/check-rls.mjs",
    "check:rls:selftest": "node tools/selftest-rls.mjs",
    "check:lockfile": "node tools/check-lockfile.mjs",
    "check:lockfile:selftest": "node tools/selftest-lockfile.mjs",
    "check:draw:selftest": "node tools/selftest-spot-check-draw.mjs",
    "check:budgets": "node tools/check-front-end-budgets.mjs",
    "check:budgets:selftest": "node tools/selftest-front-end-budgets.mjs",
    "check:prose": "node tools/check-scoreboard-prose.mjs",
    "build:web": "pnpm --filter @rms/studio-web build",
    "check:aliases": "node tools/check-aliases.mjs",
    "check:findings": "node tools/check-findings.mjs",
    "check:findings:selftest": "node tools/selftest-findings.mjs",
    "check:aliases:selftest": "node tools/selftest-aliases.mjs",
    "check:prose:selftest": "node tools/selftest-scoreboard-prose.mjs",
    "check:routesurface": "node tools/check-route-surface.mjs",
    "check:routesurface:selftest": "node tools/selftest-route-surface.mjs",
    "check:serverowned": "node tools/check-server-owned.mjs",
    "check:serverowned:selftest": "node tools/selftest-server-owned.mjs",
    "check:typesonly": "node tools/check-types-only.mjs",
    "check:typesonly:selftest": "node tools/selftest-types-only.mjs",
    "bench": "vitest run --config vitest.bench.config.ts",
    "check:determinism": "node tools/check-determinism.mjs",
    "check:determinism:selftest": "node tools/selftest-determinism.mjs",
    "check:determinism:update": "node tools/check-determinism.mjs --update",
    "check:language": "node tools/check-language.mjs",
    "check:language:selftest": "node tools/selftest-language.mjs",
    "check:contenthash": "node tools/check-content-hash.mjs",
    "check:contenthash:selftest": "node tools/selftest-content-hash.mjs",
    "check:spotrecord": "node tools/check-spot-check-record.mjs",
    "check:spotrecord:selftest": "node tools/selftest-spot-check-record.mjs",
    "check:docs": "python src/build.py",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm check:boundaries:selftest && pnpm check:boundaries && pnpm check:apps:selftest && pnpm check:apps && pnpm lint:provenance:selftest && pnpm lint:provenance && pnpm check:language:selftest && pnpm check:language && pnpm check:contenthash:selftest && pnpm check:contenthash && pnpm check:spotrecord:selftest && pnpm check:spotrecord && pnpm check:lockfile:selftest && pnpm check:lockfile && pnpm check:draw:selftest && pnpm check:rls:selftest && pnpm check:rls && pnpm check:determinism:selftest && pnpm check:determinism && pnpm check:scoreboard:selftest && pnpm check:scoreboard && pnpm check:claims:selftest && pnpm check:claims && pnpm check:typesonly:selftest && pnpm check:typesonly && pnpm check:serverowned:selftest && pnpm check:serverowned && pnpm check:routesurface:selftest && pnpm check:routesurface && pnpm check:budgets:selftest && pnpm check:budgets && pnpm check:prose:selftest && pnpm check:prose && pnpm check:aliases:selftest && pnpm check:aliases && pnpm check:findings:selftest && pnpm check:findings && pnpm coverage",
    "clean": "tsc --build --clean",
    "check:scoreboard": "node tools/check-scoreboard-sync.mjs",
    "check:scoreboard:selftest": "node tools/selftest-scoreboard-sync.mjs",
    "check:claims": "node tools/check-claims.mjs",
    "check:claims:selftest": "node tools/selftest-claims.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^2.1.0",
    "eslint": "^9.15.0",
    "fast-check": "^4.9.0",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "pg": "^8.13.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.15.0",
    "vite": "^8.2.2",
    "vitest": "^2.1.0"
  }
}
